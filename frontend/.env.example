# Frontend build-time settings (Vite). Copy to .env.local for development.
VITE_BACKEND_URL=http://localhost:3001
# The Android app always uses this API URL.
VITE_NATIVE_BACKEND_URL=https://api.example.com
VITE_APP_VERSION=2.0.0
# "cookie" when the API is served from the same site as the app (httpOnly session cookie).
VITE_AUTH_MODE=
# Optional
VITE_SENTRY_DSN=
VITE_GRIEVANCE_NAME=
VITE_GRIEVANCE_EMAIL=
