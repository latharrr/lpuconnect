{
  "name": "lputv-backend",
  "version": "2.0.0",
  "description": "LpuTV API, Socket.IO matching and signalling server",
  "type": "module",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "check": "node --check server.js && node scripts/check-syntax.mjs",
    "test": "node --test --test-concurrency=1 --test-timeout=20000 \"test/**/*.test.js\"",
    "test:coverage": "node --test --test-concurrency=1 --experimental-test-coverage --test-timeout=20000 \"test/**/*.test.js\"",
    "migrate": "node scripts/migrate.mjs",
    "backup": "node scripts/backup.mjs",
    "restore-drill": "node scripts/restore-drill.mjs",
    "loadtest": "node scripts/loadtest.mjs",
    "vapid": "node scripts/vapid.mjs"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "google-auth-library": "^10.6.1",
    "helmet": "^8.1.0",
    "pino": "^9.6.0",
    "socket.io": "^4.8.3",
    "web-push": "^3.6.7"
  },
  "optionalDependencies": {
    "@sentry/node": "^11.8.0"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.3"
  },
  "license": "MIT"
}
