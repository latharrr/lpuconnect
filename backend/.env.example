# LpuTV backend configuration. Copy to backend/.env (never commit the real file).
NODE_ENV=production
PORT=3001
RELEASE=
# Comma separated. Include https://localhost for the Android app (Capacitor).
ALLOWED_ORIGINS=https://lputv.vercel.app,https://localhost
# Number of proxy hops in front of Node (1 behind nginx).
TRUST_PROXY=1

DB_PATH=/var/lib/lputv/uniconnect.sqlite
BACKUP_DIR=/var/lib/lputv/backups
BACKUP_KEEP=14

# Long random strings (openssl rand -hex 32). Changing them unlinks analytics / device bans.
ANALYTICS_SALT=
DEVICE_SALT=
SESSION_TTL_HOURS=168

# httpOnly session cookie, only when the API and app share a site.
COOKIE_AUTH=false
COOKIE_DOMAIN=

# Google sign-in (verified badge for these email domains) and admin access.
GOOGLE_CLIENT_ID=
VERIFIED_DOMAINS=lpu.in
ADMIN_EMAILS=

# TURN (coturn with use-auth-secret). Leave empty to use STUN only.
TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
TURN_SECRET=
TURN_TTL_SECONDS=3600

# Web push (npm run vapid prints a key pair).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
QUIET_HOURS=23-8

# Monitoring and alerts
SENTRY_DSN=
ALERT_WEBHOOK_URL=
LOG_LEVEL=info

# Moderation defaults (admins can change these at runtime)
AUTOBAN_REPORTS=3
AUTOBAN_WINDOW_HOURS=24
AUTOBAN_HOURS=24

# Retention (days)
RETAIN_EVENTS_DAYS=90
RETAIN_REPORTS_DAYS=365

# Phone (WhatsApp OTP) login - disabled unless OTP_ENABLED=true
OTP_ENABLED=false
# Sender: dry (log only, dev/test) | openwa (wa-relay bridge) | cloudapi (stub for official API)
OTP_SENDER=dry
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_PER_NUMBER_PER_DAY=3
OTP_PER_IP_PER_HOUR=10
OTP_DAILY_CAP=100
OTP_MIN_SEND_GAP_MS=10000
OTP_RESEND_GAP_SECONDS=60
OTP_HASH_SALT=
OPENWA_SEND_URL=http://127.0.0.1:8787/admin/send
OPENWA_SECRET=
